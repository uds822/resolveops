# ResolveOps Configuration Template
# Copy this file to .env and insert your real API keys

# NVIDIA NIM API (Get your key from https://build.nvidia.com)
NVIDIA_API_KEY=

# OpenRouter API (Get your key from https://openrouter.ai)
OPENROUTER_API_KEY=

# Required for POST /api/v1/ingest and DELETE /api/v1/documents/{document_id}.
# Send this value in the X-API-Key header. Leave unset to disable mutations.
RESOLVEOPS_INGEST_API_KEY=

# Set explicitly for offline mock generation if no provider key is configured.
# RESOLVEOPS_LLM_MODEL=mock
# RESOLVEOPS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

